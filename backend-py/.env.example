# ─── Shared infra ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://elimuai_user:elimuai_pass_dev@postgres:5432/elimuai_db
REDIS_URL=redis://redis:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_64_char_random_string_in_production_do_not_ship_this
JWT_ACCESS_TTL_MIN=10080          # 7 days
JWT_REFRESH_TTL_MIN=43200         # 30 days
SCHOOL_SIGNUP_TOKEN=              # if set, /register with role=admin requires body.signup_token

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SEC=60

# ─── Queue HMAC (shared with mpesa-service) ─────────────────────────────────
QUEUE_HMAC_SECRET=change_me_to_a_64_char_random_string_in_production

# ─── Cross-service base URLs (used by httpx client) ─────────────────────────
AUTH_SERVICE_URL=http://auth-service:5100
USERS_SERVICE_URL=http://users-service:5101
SCHOOLS_SERVICE_URL=http://schools-service:5102
BILLING_SERVICE_URL=http://billing-service:5103
LEARNING_SERVICE_URL=http://learning-service:5104
ADMIN_SERVICE_URL=http://admin-service:5105

# ─── External providers ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Email — free-tier providers (worker picks the first one that has a key set):
#   1. Resend  → 3,000/mo, 100/day free forever — https://resend.com/api-keys
#   2. Brevo   → 300/day free forever          — https://app.brevo.com/settings/keys/api
#   3. Mailtrap → 1,000/mo free (live send)     — https://mailtrap.io/api-tokens
#   4. SMTP    → any host you already own
RESEND_API_KEY=
BREVO_API_KEY=
MAILTRAP_API_URL=https://send.api.mailtrap.io
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ElimuAI
SMTP_FROM_EMAIL=onboarding@resend.dev

# SMS — Africa's Talking
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# ─── Env ────────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
