# ─── cPanel monolith environment (copy to backend app root as .env) ─────────
# MySQL credentials come from cPanel → MySQL Databases.
# Format: mysql+aiomysql://<cpaneluser_dbuser>:<password>@localhost/<cpaneluser_dbname>
DATABASE_URL=mysql+aiomysql://elimu_user:CHANGE_ME@localhost/elimu_db

# No Redis on shared hosting — LocalEventBus is used automatically.
# redis_url is unused but harmless if set.

JWT_SECRET=change_me_to_a_64_char_random_string_in_production_do_not_ship_this
JWT_ACCESS_TTL_MIN=10080
JWT_REFRESH_TTL_MIN=43200
SCHOOL_SIGNUP_TOKEN=

# SECURITY: must stay false on cPanel — there is no gateway stripping
# X-User-Id headers from client requests.
TRUST_GATEWAY_HEADERS=false

# Comma-separated allowed browser origins (frontend domains).
CORS_ORIGINS=https://elimuai.africa,https://www.elimuai.africa

OTP_EXPIRY_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SEC=60

# ─── External providers ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Payment gateway (venus) — HTTP path; BullMQ/mpesa-service is not used here.
PAYMENT_GATEWAY_URL=https://venus.elimuai.africa
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Email (first configured provider wins: Resend → Brevo → Mailtrap → SMTP)
RESEND_API_KEY=
BREVO_API_KEY=
MAILTRAP_API_URL=https://send.api.mailtrap.io
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ElimuAI
SMTP_FROM_EMAIL=noreply@elimuai.africa

# SMS — Africa's Talking
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# S3-compatible storage for uploads (optional; leave empty to disable)
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=elimuai-uploads

ENV=production
LOG_LEVEL=INFO
