# ─── Stage 1: build the Next.js static export ───────────────────────────────
# Build context for this Dockerfile MUST be the repo root so it can COPY
# both frontend/ and backend-py/gateway/.
FROM node:20-alpine AS frontend-build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
# `output: "export"` in next.config.mjs writes the site to /app/out
RUN npm run build

# ─── Stage 2: nginx that serves both the static frontend and the /api proxy ─
FROM nginx:1.29-alpine
# apk upgrade pulls Alpine security fixes (openssl/curl/libxml2/libpng/expat)
RUN apk upgrade --no-cache && apk add --no-cache curl
COPY backend-py/gateway/nginx.prod.conf /etc/nginx/nginx.conf
COPY --from=frontend-build /app/out /usr/share/nginx/html
EXPOSE 8091
