# Copy to prod.env and fill values. This file gets uploaded to S3 and pulled
# by every container in the Fargate task as an EnvironmentFile. NEVER commit
# the real prod.env to git.

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=elimuai_db
POSTGRES_USER=elimuai_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# All containers in the Fargate task share one ENI, so cross-container
# comms use 127.0.0.1 rather than compose DNS names.
DATABASE_URL=postgresql+asyncpg://elimuai_user:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/elimuai_db
REDIS_URL=redis://127.0.0.1:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_ACCESS_TTL_MIN=10080
JWT_REFRESH_TTL_MIN=43200
SCHOOL_SIGNUP_TOKEN=REPLACE_WITH_STRONG_TOKEN

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SEC=60

# ─── Inter-service URLs (localhost within the Fargate task) ─────────────────
QUEUE_HMAC_SECRET=REPLACE_WITH_STRONG_TOKEN
AUTH_SERVICE_URL=http://127.0.0.1:5100
USERS_SERVICE_URL=http://127.0.0.1:5101
SCHOOLS_SERVICE_URL=http://127.0.0.1:5102
BILLING_SERVICE_URL=http://127.0.0.1:5103
LEARNING_SERVICE_URL=http://127.0.0.1:5104
ADMIN_SERVICE_URL=http://127.0.0.1:5105

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
BREVO_API_KEY=
MAILTRAP_API_URL=https://send.api.mailtrap.io
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ElimuAI
SMTP_FROM_EMAIL=noreply@elimuai.africa

# ─── SMS (Africa's Talking) ──────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=
# ─── External payment gateway ─────────────────────────────────────
# Non-secret gateway config lives here. API_KEY / API_SECRET are injected by
# ECS from AWS Secrets Manager at task startup and must NOT be set here.
# See scripts/set-payment-gateway-secret.sh to create/rotate the secret and
# pass its ARN via `PAYMENT_GATEWAY_SECRET_ARN` when running deploy-ecs-fargate.sh.
#
# ⚠️  IMPORTANT: If PAYMENT_GATEWAY_URL is set but the API key/secret fail to
# inject (typo in the Secrets Manager JSON keys, missing IAM permissions,
# stale task definition, etc.) billing-service will now return HTTP 503 and
# mark the payment as `failed` with metadata `{"error":"gateway_misconfigured"}`.
# Previously it silently enqueued to a BullMQ queue with no consumer and the
# payment sat pending forever. Check payments.metadata to diagnose.
PAYMENT_GATEWAY_URL=https://venus.elimuai.africa
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_64_CHAR_HEX

# ─── Payment reconciliation sweeper ───────────────────────────────
# billing-service periodically polls the gateway for pending payments whose
# webhook we may have missed, and applies the authoritative status. Defaults
# are reasonable; tune only if you know why.
# RECONCILER_ENABLED=true
# RECONCILER_INTERVAL_SECONDS=60      # how often the sweeper runs
# RECONCILER_MIN_AGE_SECONDS=90       # skip rows younger than this
# RECONCILER_MAX_AGE_SECONDS=86400    # give up on rows older than this
# RECONCILER_BATCH_SIZE=25            # rows per sweep
# ─── Runtime ─────────────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO

# ─── S3 uploads (real AWS S3 in prod, not MinIO) ─────────────────────────────
# Leave S3_ENDPOINT_URL empty and S3_FORCE_PATH_STYLE=false so boto3 uses the
# real virtual-hosted AWS S3 URL scheme. The task role grants access via IAM,
# so no S3_ACCESS_KEY/S3_SECRET_KEY needed inside the task.
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=elimuai-uploads-977233000130
S3_FORCE_PATH_STYLE=false

# ─── Frontend origin (for CORS) ──────────────────────────────────────────────
FRONTEND_URL=https://venus.elimuai.africa
CORS_ORIGINS=https://venus.elimuai.africa
